{
  "name": "sendo",
  "version": "0.0.0",
  "private": true,
  "description": "Fresh feeds, guided. Open-source RSS/Atom aggregator server with REST API, MCP support, and Google Reader API compatibility.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vitest-plugin": "1.4.11",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "hono": "4.13.14"
  }
}
