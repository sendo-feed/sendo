{
  "name": "sendo",
  "version": "0.0.0",
  "private": true,
  "description": "Fresh feeds, guided. Open-source RSS/Atom aggregator server with REST API and MCP support.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": "^22.21.0 || >=24.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "esbuild src/platform/node/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=dist/node/sendo.mjs",
    "build:native": "node scripts/build-native.mjs",
    "start": "node --enable-source-maps dist/node/sendo.mjs",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "token:create": "node scripts/dev.mjs token:create",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p scripts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm check:rust && pnpm build:native && pnpm test",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@hono/node-server": "2.1.6",
    "@hono/zod-openapi": "1.6.3",
    "@libsql/client": "0.18.0",
    "@modelcontextprotocol/server": "2.4.0",
    "drizzle-orm": "0.45.4",
    "entities": "9.0.0",
    "feedsmith": "3.0.1",
    "hono": "4.13.16",
    "undici": "8.12.4",
    "ws": "8.22.1",
    "zod": "4.6.7"
  }
}
