{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendo",
  "main": "src/index.ts",
  // 日付を上げるときは、Workers の互換性の変更点を確かめてから上げる
  "compatibility_date": "2026-10-29",
  // nodejs_compat は付けない。Web 標準の API だけで書く（docs/decisions/tech-stack.md）
  "observability": {
    "enabled": true
  },

  // database_id は書かない。各自がデプロイしたときに、自分のアカウントに自動で作られる
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sendo",
      "migrations_dir": "migrations"
    }
  ],

  // 取得や全文抽出などの重い処理は、API の応答と切り離してキューで流す
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "sendo-jobs" }],
    "consumers": [
      {
        "queue": "sendo-jobs",
        // D1 は 1 回の実行で 50 クエリまで（無料プラン）。まとめて受け取るとジョブの分が足し合わさる
        // ので、1 件ずつ処理する。各ジョブは、それだけで上限に収まるように作る（src/db/chunk.ts）
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },

  // 取得の時期が来たフィードを、10 分おきにキューへ積む
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  // 秘密情報は、手元では .dev.vars に書く（.dev.vars.example を参照）。本番は wrangler secret put で入れる
  "secrets": {
    "required": []
  }
}
