{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendo",
  "main": "src/index.ts",
  // 日付を上げるときは、Workers の互換性の変更点を確かめてから上げる
  "compatibility_date": "2026-10-29",
  // nodejs_compat は付けない。Web 標準の API だけで書く（docs/decisions/tech-stack.md）
  "observability": {
    "enabled": true
  },

  // database_id は書かない。各自がデプロイしたときに、自分のアカウントに自動で作られる
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sendo",
      "migrations_dir": "migrations"
    }
  ],

  // 取得や全文抽出などの重い処理は、API の応答と切り離してキューで流す。仕事は最大 10 個の封筒に
  // 束ねて 1 つのメッセージにし、受け手が 1 つずつ別の実行（ctx.exports の JobRunner）で動かす
  // （docs/decisions/jobs.md、src/platform/cloudflare/queue.ts）
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "sendo-jobs" }],
    "consumers": [
      {
        "queue": "sendo-jobs",
        // 1 回に受け取る封筒は 1 つ。失敗した仕事は、受け手がその仕事だけを積み直す。
        // max_retries は、受け手の実行そのものが落ちたときに、封筒ごとやり直す回数
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },

  // 取得の時期が来たフィードを、10 分おきにキューへ積む。間隔を変えたら、src/platform/index.ts の
  // MIN_FETCH_INTERVAL_MINUTES も合わせる
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  // 秘密ではない設定。手元では .dev.vars で上書きできる
  "vars": {
    // フィードを取得する間隔（分）。10 以上の整数で、空なら 30。回せるフィードの数は、プランと
    // この間隔で決まる（README の「取得の間隔」、docs/decisions/jobs.md）
    "FETCH_INTERVAL_MINUTES": "30",

    // スターのない記事を、取り込んでから消すまでの日数。30 以上の整数で、空なら 90。未読でも消す
    // （docs/decisions/retention.md）。長くすると、D1 の容量を多く使う（docs/cost.md）
    "ARTICLE_RETENTION_DAYS": "90",

    // OAuth（Claude.ai や ChatGPT から MCP につなぐ）を使うときに書く。2 つとも空なら OAuth は使えない
    // （/mcp は MCP 用のトークンだけで使える）
    // Sendo を外から呼ぶときのオリジン（例：https://sendo.example.workers.dev）。OAuth の発行者になる
    "PUBLIC_URL": "",
    // 許可の画面を置く sendo-reader のオリジン（例：https://reader.example.workers.dev）
    "READER_URL": ""
  },

  // 秘密情報は、手元では .dev.vars に書く（.dev.vars.example を参照）。本番は wrangler secret put で入れる。
  // ここに挙げたものは、ないとデプロイが止まる（手元では警告だけ）。.dev.vars も、ここに挙げたものしか読まれない
  "secrets": {
    "required": ["ALLOWED_EMAILS", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
  }
}
