# 依存
node_modules

# ビルドと実行の生成物
dist/
# Rust のビルドの生成物と、Node から読み込むネイティブのモジュール（pnpm build:native）
target
native/
# コンテナ版を手元で動かしたときのデータ（DATA_DIR=./.data）
.data/
coverage/

# 手元の設定と秘密情報。.env.example を写して使う
.env
.env.*
!.env.example
# pnpm token:create で発行したアクセストークンの控え
.sendo-token

# ログ
*.log

# OS とエディタ
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# 作業用のディレクトリ（別のブランチの git worktree、一時ファイル）。リポジトリの直下だけ。中身はコミットしない
/.worktrees/
/tmp/

# Claude Code の個人設定と、Claude Code が作る git worktree
.claude/settings.local.json
.claude/worktrees/
