# 依存
node_modules/

# ビルドと実行の生成物
dist/
.wrangler/
coverage/

# wrangler types の生成物（pnpm install のときに生成する）
worker-configuration.d.ts

# 手元の秘密情報。.dev.vars.example を写して使う
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
# pnpm token:create で発行したアクセストークンの控え
.sendo-token

# ログ
*.log

# OS とエディタ
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# 作業用のディレクトリ（別のブランチの git worktree、一時ファイル）。リポジトリの直下だけ。中身はコミットしない
/.worktrees/
/tmp/

# Claude Code の個人設定と、Claude Code が作る git worktree
.claude/settings.local.json
.claude/worktrees/
