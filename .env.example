# コンテナ版の設定（docs/decisions/container.md の 11）。.env に写して書く。.env は git に入れない。
# 名前は Cloudflare 版と同じ。空のものは、入れなければ既定で動く

# ブラウザでログインできるメールアドレス（カンマか空白で区切る）と、Google のクライアント。
# なければブラウザのログインは使えず、アクセストークンだけで使う
ALLOWED_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 外から呼ぶときのオリジン。compose.yaml のとおり sendo-reader と並べるなら、reader のオリジン
# （例：https://reader.example.com）を入れる。リクエストの URL を、このオリジンにそろえる（手前の
# リバースプロキシで TLS を終えるため）。なければ、ブラウザのログインの戻り先が合わない。
# READER_URL と 2 つとも入れると、OAuth（Claude.ai などから MCP につなぐ）も使える
PUBLIC_URL=
# 許可の画面を置く sendo-reader のオリジン。sendo-reader と並べるなら、PUBLIC_URL と同じ値
READER_URL=

# フィードを取得する間隔（分）。10 以上の整数で、既定は 30
FETCH_INTERVAL_MINUTES=
# スターのない記事を、取り込んでから消すまでの日数。30 以上の整数で、既定は 90
ARTICLE_RETENTION_DAYS=
