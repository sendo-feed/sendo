# コンテナ版の設定（docs/decisions/container.md の 11）。.env に写して書く。.env は git に入れない。
# 名前は Cloudflare 版と同じ。空のものは、入れなければ既定で動く

# ブラウザでログインできるメールアドレス（カンマか空白で区切る）と、Google のクライアント。
# なければブラウザのログインは使えず、アクセストークンだけで使う
ALLOWED_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sendo を外から呼ぶときのオリジン（例：https://sendo.example.com）。リクエストの URL を、
# このオリジンにそろえる（手前のリバースプロキシで TLS を終えるため）。READER_URL と 2 つとも
# 入れると、OAuth（Claude.ai などから MCP につなぐ）も使える
PUBLIC_URL=
# 許可の画面を置く sendo-reader のオリジン
READER_URL=

# フィードを取得する間隔（分）。10 以上の整数で、既定は 30
FETCH_INTERVAL_MINUTES=
# スターのない記事を、取り込んでから消すまでの日数。30 以上の整数で、既定は 90
ARTICLE_RETENTION_DAYS=
