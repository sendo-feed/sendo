# Sendo の設定（docs/decisions/container.md の 11）。.env に写して書く。.env は git に入れない。
# compose.yaml で動かすときも、手元で pnpm dev で動かすときも、このファイルを読む。
# 空のものは、入れなければ既定で動く

# ブラウザでログインできるメールアドレス（カンマか空白で区切る）と、Google のクライアント。
# なければブラウザのログインは使えず、アクセストークンだけで使う。
# Google のクライアントは、Google Cloud のコンソールで作る（種類は「ウェブ アプリケーション」）。
# 「承認済みのリダイレクト URI」には、ブラウザから見た <オリジン>/api/v1/auth/google/callback を登録する
# （手元の sendo-reader なら http://localhost:5173/api/v1/auth/google/callback）
ALLOWED_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 外から呼ぶときのオリジン。compose.yaml のとおり sendo-reader と並べるなら、reader のオリジン
# （例：https://reader.example.com）を入れる。リクエストの URL を、このオリジンにそろえる（手前の
# リバースプロキシで TLS を終えるため）。なければ、ブラウザのログインの戻り先が合わない。
# READER_URL と 2 つとも入れると、OAuth（Claude.ai などから MCP につなぐ）も使える
PUBLIC_URL=
# 許可の画面を置く sendo-reader のオリジン。sendo-reader と並べるなら、PUBLIC_URL と同じ値
READER_URL=

# フィードを取得する間隔の下限（分）。10 以上の整数で、既定は 30。実際の間隔は、フィードごとに
# 記事の出るペースから決まる（1 日まで）
FETCH_INTERVAL_MINUTES=
# 記事と本文の保存容量（MiB）。16 以上の整数。既定は 10240（10 GiB）
# 空きがある間は残し、90% に達すると古いスターなし記事から片付ける。日数の期限はない
# DB の索引などは見積もり。バックアップや WAL は別なので、配置先には余裕を残す
STORAGE_LIMIT_MIB=

# 日本語以外の記事を Claude API で訳すときに設定する（docs/decisions/translation.md）。
# キーは Claude Platform（Console）で作る。空なら翻訳は動かず、記事を外へ送らない
ANTHROPIC_API_KEY=
# 訳すモデルを固定するときに書く。空なら、Models API で最新の Sonnet を選ぶ（1 日 1 回選び直す）
TRANSLATION_MODEL=

# Discord の購読を使うときに設定する。リダイレクト先は
# <READER_URL>/api/v1/integrations/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
